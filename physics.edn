;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a workshop scheduling/logistics coordination
;; robot schedules the crew, logs commissions and coordinates fabric/pelt/
;; millinery supply for a tailoring/dressmaking workshop; it never does the
;; garment construction itself. Its physical work is workshop logistics:
;; carrying fabric bolts from the store to the cutting table and lifting a
;; bolt onto the table's roll holder.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-7531"
 :cases
 [{:id :fabric-bolt-trolley
   :kind :transport
   :procedure "trolley carries fabric bolts standing upright from the fabric store to the cutting table"
   :params {:mass-kg 40.0 :distance-m 20.0 :v-max-mps 0.8 :a-max-mps2 0.5
            :brake-decel-mps2 2.0 :drive-force-n 120.0 :crr 0.02
            :cog-height-m 0.25 :payload-cog-height-m 0.75 :support-half-length-m 0.25
            :max-time-s 600.0}
   :sweep {:param :payload-kg :values [10.0 20.0 40.0 60.0 90.0]}
   :quantity :min-tipover-margin
   :limit {:min 0.3 :basis "estimate: 30 % tip-over reserve for upright bolts when the trolley makes an emergency stop at 2 m/s²"}}
  {:id :bolt-onto-roll-holder
   :kind :manipulator
   :procedure "arm lifts a fabric bolt from the trolley onto the cutting table's roll holder"
   :params {:l1-m 0.50 :l2-m 0.45 :m1-kg 5.0 :m2-kg 3.5
            :from [0.60 0.10] :to [0.30 0.70] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [2.0 4.0 6.0 8.0 12.0]}
   :quantity :peak-tau1-nm
   :limit {:max 90.0 :basis "estimate: continuous shoulder torque of a ~7 kg-class collaborative arm"}
   :boundary {:lo 0.5 :hi 40.0}}]}
